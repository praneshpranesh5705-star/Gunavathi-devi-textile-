# ---------------------------------------------------------------------------
# Gunavathi Tex — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the two values from your Supabase
# project. Both are safe to expose to the browser — they are the public
# project URL and the public "anon" key. Row Level Security in the database is
# what actually protects your data, not the secrecy of these values.
#
# Where to find them:
#   Supabase dashboard -> your project -> Settings -> API
#
# NEVER put the `service_role` key in this file. This app does not use it and
# does not need it. See SETUP.md for the full walkthrough.
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your public anon key (a long JWT starting with "eyJ...")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the public base URL of the site, used for canonical links and
# Open Graph tags. Leave blank in development.
NEXT_PUBLIC_SITE_URL=
